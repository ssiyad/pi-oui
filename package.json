{
  "name": "pi-oui-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "library": "tsx scripts/library.ts",
    "build:renderer": "npm run build -w packages/renderer",
    "copy:renderer": "node scripts/copy-renderer.mjs",
    "build": "npm run library && npm run build:renderer && npm run copy:renderer",
    "size": "node scripts/size.mjs",
    "test": "npm test -w packages/pi",
    "check": "npm run check -w packages/pi && npm run check -w packages/renderer"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
