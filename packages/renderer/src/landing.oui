root = Stack([hero, steps, example, reasons, install, footer], "column", "2xl")
hero = Stack([heroTitle, heroText, heroButtons], "column", "l")
heroTitle = TextContent("Make a web page in Pi. Share it with a link.", "large-heavy")
heroText = TextContent("Ask the [Pi](https://pi.dev/) agent for a page: a dashboard, a report, a chart. You get a link that anyone can open. No account, no login, nothing to install.", "large")
heroButtons = Buttons([getStarted, github])
getStarted = Button("Get started", @OpenUrl("https://github.com/ssiyad/pi-oui#readme"), "primary")
github = Button("View on GitHub", @OpenUrl("https://github.com/ssiyad/pi-oui"), "secondary")
steps = Card([stepsHeader, stepsList])
stepsHeader = CardHeader("How it works", "Three steps, all in Pi")
stepsList = Steps([step1, step2, step3])
step1 = StepsItem("Ask", "Tell the agent what you want, for example \"make a page of these numbers\".")
step2 = StepsItem("Share", "The agent makes the page and gives you a link. Anyone with it can open the page, like this one.")
step3 = StepsItem("Change", "Ask for changes at any time. The page updates, and the link stays the same.")
example = Card([exampleHeader, sourceCard, resultCard])
exampleHeader = CardHeader("A page is a few lines", "The agent writes them. You never have to.")
sourceCard = Card([sourceLabel, chartSource], "sunk")
sourceLabel = TextContent("What the agent writes", "small-heavy")
resultCard = Card([resultLabel, chartHeader, chart], "sunk")
resultLabel = TextContent("What you get", "small-heavy")
chartHeader = InlineHeader("Weekly signups", "Last six weeks")
chart = BarChart(weeks, [signups])
weeks = ["W1", "W2", "W3", "W4", "W5", "W6"]
signups = Series("Signups", [120, 146, 132, 171, 198, 224])
chartSource = CodeBlock("text", "root = Stack([header, chart])\nheader = InlineHeader(\"Weekly signups\", \"Last six weeks\")\nchart = BarChart(weeks, [signups])\nweeks = [\"W1\", \"W2\", \"W3\", \"W4\", \"W5\", \"W6\"]\nsignups = Series(\"Signups\", [120, 146, 132, 171, 198, 224])")
reasons = ContextCardBlock([reasonOpen, reasonSafe, reasonYours, reasonRemix])
reasonOpen = ContextCardItem("open", "Easy to open", "A link opens in any browser. Readers do not need Pi or an account.")
reasonSafe = ContextCardItem("safe", "Safe to open", "Pages are made of ready-made parts only. They cannot run code.")
reasonYours = ContextCardItem("yours", "Yours to keep", "Each page is a secret Gist on your GitHub account. Delete it to take the page down.")
reasonRemix = ContextCardItem("remix", "Easy to remix", "Every shared page has a remix button. Copy a page into Pi and make it your own.")
install = Card([installHeader, installCode, installNote])
installHeader = CardHeader("Try it", "Add pi-oui to Pi, then ask for a page.")
installCode = CodeBlock("bash", "pi install npm:pi-oui")
installNote = TextContent("Pages go into secret Gists on your GitHub account. Install the [GitHub CLI](https://cli.github.com) and run `gh auth login` once.", "small")
footer = TextContent("This page is a pi-oui page too. [See what it is made of](https://github.com/ssiyad/pi-oui/blob/main/packages/renderer/src/landing.oui). Free and open source under the MIT license.", "small")
