{
  "name": "pi-oui",
  "version": "0.1.0",
  "description": "Make shareable web pages with OpenUI from Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssiyad/pi-oui.git",
    "directory": "packages/pi"
  },
  "homepage": "https://github.com/ssiyad/pi-oui#readme",
  "bugs": "https://github.com/ssiyad/pi-oui/issues",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "src",
    "skills",
    "library",
    "renderer",
    "README.md"
  ],
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@openuidev/lang-core": "1.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "26.6.6",
    "typebox": "1.4.3"
  }
}
