]]>openui:content?library=openui%400.18.1
root = Stack([title, kpis, tabs, notes])
title = CardHeader("Support: October 2026", "Tickets handled by the platform team")
kpis = Stack([kpiOpen, kpiClosed, kpiSla], "row", "m", "stretch")
kpiOpen = Card([TextContent("Open", "small"), TextContent("" + @Count(@Filter(tickets, "status", "==", "open")), "large-heavy")])
kpiClosed = Card([TextContent("Closed", "small"), TextContent("" + @Count(@Filter(tickets, "status", "==", "closed")), "large-heavy")])
kpiSla = Card([TextContent("SLA met", "small"), TextContent("94%", "large-heavy")])
tabs = Tabs([tabTrend, tabTickets, tabSplit])
tabTrend = TabItem("trend", "Trend", [trend])
trend = LineChart(weeks, [Series("Opened", [42, 51, 38, 47]), Series("Closed", [39, 49, 44, 50])], "natural", "Week", "Tickets")
weeks = ["W40", "W41", "W42", "W43"]
tabTickets = TabItem("tickets", "Tickets", [table])
table = Table([Col("ID", tickets.id), Col("Subject", tickets.subject), Col("Priority", @Each(tickets, "t", Tag(t.priority, null, "sm", t.priority == "high" ? "danger" : t.priority == "medium" ? "warning" : "neutral"))), Col("Status", tickets.status)])
tabSplit = TabItem("split", "By priority", [pie])
pie = PieChart(["High", "Medium", "Low"], [@Count(@Filter(tickets, "priority", "==", "high")), @Count(@Filter(tickets, "priority", "==", "medium")), @Count(@Filter(tickets, "priority", "==", "low"))], "donut")
tickets = [{id: 81048, subject: "Payment entry fails on submit", priority: "high", status: "open"}, {id: 81051, subject: "Print format cuts the footer", priority: "medium", status: "closed"}, {id: 81060, subject: "Slow report for stock ledger", priority: "high", status: "open"}, {id: 81062, subject: "Email digest sent twice", priority: "low", status: "closed"}, {id: 81077, subject: "Workflow skips approval", priority: "medium", status: "open"}]
notes = Card([InlineHeader("Notes", "From the weekly review"), MarkDownRenderer("- Payment bug is **fixed** in v15.42.\n- Stock ledger report needs an index. See `stock_ledger_entry`.\n- <b>raw html</b> must not render.\n- [bad link](javascript:alert(1))"), CodeBlock("sql", "ALTER TABLE `tabStock Ledger Entry`\n  ADD INDEX posting_sort (posting_date, posting_time);")])
